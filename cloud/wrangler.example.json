{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "displayos",
  "account_id": "<your-cloudflare-account-id>",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{ "name": "PILOT", "class_name": "PilotState" }, { "name": "REGISTRY", "class_name": "ProductRegistry" }, { "name": "HOMES", "class_name": "HouseholdState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PilotState"] }, { "tag": "displayos-v2", "new_sqlite_classes": ["ProductRegistry", "HouseholdState"] }],
  "vars": { "PUBLIC_ORIGIN": "https://displayos.<your-subdomain>.workers.dev" },
  "observability": { "enabled": false }
}
